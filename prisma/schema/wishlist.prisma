// Wishlist: a personal, shareable gift registry (share-link only in v1).
// Contributions ride the donation rails — the wishlist never moves money
// itself, it only records what the charge dispatcher already verified.
model wishlists {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  title      String           @db.VarChar(120)
  /// Scoped per owner: the share URL is /<username>/<slug>, so two members
  /// can both have a "christmas" registry without suffix wars.
  slug       String           @db.VarChar(80)
  message    String?          @db.VarChar(500)
  status     String           @default("active")
  /// Reserved for a future public discovery directory. v1 distributes
  /// wishlists through share links only; the column ships now so that
  /// feature needs no migration.
  is_public  Boolean          @default(false)
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  items      wishlist_items[]
  user       User             @relation(fields: [user_id], references: [id])

  @@unique([user_id, slug], map: "uq_wishlists_user_slug")
  @@index([status], map: "idx_wishlists_status")
  @@index([user_id], map: "idx_wishlists_user_id")
}

model wishlist_items {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlist_id   String                   @db.Uuid
  name          String                   @db.VarChar(140)
  /// Target cost in naira. Locked once contributed is above zero — enforced
  /// in the update action, not here, so the ledger always resolves to a
  /// price the owner actually promised.
  price         Decimal                  @db.Decimal
  /// Denormalized running total. The contributions ledger is the source of
  /// truth; this counter moves inside the same transaction as each ledger
  /// insert.
  contributed   Decimal                  @default(0) @db.Decimal
  note          String?                  @db.VarChar(280)
  sort_order    Int                      @default(0)
  /// Set in the contribution transaction when contributed first reaches
  /// price; drives the funded state and the owner's fully-funded email.
  funded_at     DateTime?                @db.Timestamptz(6)
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  contributions wishlist_contributions[]
  wishlist      wishlists                @relation(fields: [wishlist_id], references: [id], onDelete: Cascade)

  @@index([wishlist_id], map: "idx_wishlist_items_wishlist_id")
}

model wishlist_contributions {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id            String         @db.Uuid
  /// Set when the giver is signed in; anonymous or guest gifts leave it null.
  user_id            String?        @db.Uuid
  /// Gift amount in naira, before the donor-side service and provider fees.
  amount             Decimal        @db.Decimal
  name               String?
  email              String
  message            String?        @db.VarChar(280)
  is_anonymous       Boolean        @default(false)
  /// Rows are written only from the verified charge path, mirroring donations.
  status             String         @default("completed")
  /// Idempotency key from the provider webhook; a replayed charge.success
  /// cannot double-credit an item.
  paystack_reference String?        @unique @db.VarChar
  payment_provider   String         @default("paystack") @db.VarChar
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  item               wishlist_items @relation(fields: [item_id], references: [id])
  user               User?          @relation(fields: [user_id], references: [id])

  @@index([item_id], map: "idx_wishlist_contributions_item_id")
  @@index([user_id], map: "idx_wishlist_contributions_user_id")
}
