model wishlists {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  title      String           @db.VarChar(120)
  slug       String           @db.VarChar(80)
 message    String?          @db.VarChar(500)
image_url  String?          @db.VarChar(500)
  status     String           @default("active")
  is_public  Boolean          @default(false)
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  items      wishlist_items[]
  user       User             @relation(fields: [user_id], references: [id])

  @@unique([user_id, slug], map: "uq_wishlists_user_slug")
  @@index([status], map: "idx_wishlists_status")
  @@index([user_id], map: "idx_wishlists_user_id")
}

model wishlist_items {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlist_id   String                   @db.Uuid
  name          String                   @db.VarChar(140)
  price         Decimal                  @db.Decimal
  contributed   Decimal                  @default(0) @db.Decimal
  note          String?                  @db.VarChar(280)
  image_url     String?                  @db.VarChar(500)
  sort_order    Int                      @default(0)
  funded_at     DateTime?                @db.Timestamptz(6)
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  contributions wishlist_contributions[]
  wishlist      wishlists                @relation(fields: [wishlist_id], references: [id], onDelete: Cascade)

  @@index([wishlist_id], map: "idx_wishlist_items_wishlist_id")
}

model wishlist_contributions {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id            String         @db.Uuid
  user_id            String?        @db.Uuid
  amount             Decimal        @db.Decimal
  name               String?
  email              String
  message            String?        @db.VarChar(280)
  is_anonymous       Boolean        @default(false)
  status             String         @default("completed")
  paystack_reference String?        @unique @db.VarChar
  payment_provider   String         @default("paystack") @db.VarChar
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  item               wishlist_items @relation(fields: [item_id], references: [id])
  user               User?          @relation(fields: [user_id], references: [id])

  @@index([item_id], map: "idx_wishlist_contributions_item_id")
  @@index([user_id], map: "idx_wishlist_contributions_user_id")
}
